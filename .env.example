# Local HTTP server. Use 0.0.0.0 so Eureka and the Gateway can reach this service.
APP_NAME=hs-ai-service
APP_ENV=local
HOST=0.0.0.0
PORT=8084
LOG_LEVEL=INFO

# Same Eureka server used by hs-chat-service and hs-news-service.
EUREKA_CLIENT_SERVICE_URL=http://localhost:8761/eureka
# localhost means auto-detect the IPv4 address used for outbound network traffic.
# Set this explicitly when automatic detection chooses a non-routable adapter.
EUREKA_INSTANCE_HOSTNAME=localhost
EUREKA_HEARTBEAT_INTERVAL_SECONDS=30

# AI service calls other HomeSpace APIs through Gateway and forwards the inbound
# Bearer token. Do not put credentials or tokens in this file.
GATEWAY_BASE_URL=http://localhost:8080
GATEWAY_REQUEST_TIMEOUT_SECONDS=15

# Internal Gateway Secret (must match hs-gateway-server secret)
# Generate a random value and set the same value in Gateway's .env.dev.
# AI authenticated endpoints reject requests until this is configured.
GATEWAY_INTERNAL_SECRET=

# Database configuration (PostgreSQL with pgvector on port 5433)
AI_DATABASE_URL=postgresql+asyncpg://homespace:homespace123@localhost:5433/homespace_ai

# Local Embedding (sentence-transformers runs on CPU)
EMBEDDING_MODEL_ID=intfloat/multilingual-e5-small
EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
MODEL_CACHE_DIR=./models_cache

# Chunking and Limits
CHUNK_TARGET_TOKENS=350
CHUNK_OVERLAP_TOKENS=50
CHUNK_MAX_TOKENS=450
CHUNK_CONFIG_VERSION=v1
UPLOAD_MAX_SIZE_BYTES=1048576

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.80


# Generative Provider (disabled | gemini | groq)
GENERATION_PROVIDER=disabled
# Choose a currently supported model from the selected provider's model list.
GENERATION_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
GENERATION_MAX_OUTPUT_TOKENS=1024
GENERATION_TEMPERATURE=0.2
GENERATION_TIMEOUT_SECONDS=20.0

# Worker
WORKER_POLL_INTERVAL_SECONDS=2.0
WORKER_LEASE_DURATION_SECONDS=60
WORKER_MAX_ATTEMPTS=3
