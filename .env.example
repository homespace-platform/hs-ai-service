# Local HTTP server. Use 0.0.0.0 so Eureka and the Gateway can reach this service.
APP_NAME=hs-ai-service
APP_ENV=local
HOST=0.0.0.0
PORT=8084
LOG_LEVEL=INFO

# Same Eureka server used by hs-chat-service and hs-news-service.
EUREKA_CLIENT_SERVICE_URL=http://localhost:8761/eureka
# localhost means auto-detect the IPv4 address used for outbound network traffic.
# Set this explicitly when automatic detection chooses a non-routable adapter.
EUREKA_INSTANCE_HOSTNAME=localhost
EUREKA_HEARTBEAT_INTERVAL_SECONDS=30

# AI service calls other HomeSpace APIs through Gateway and forwards the inbound
# Bearer token. Do not put credentials or tokens in this file.
GATEWAY_BASE_URL=http://localhost:8080
GATEWAY_REQUEST_TIMEOUT_SECONDS=15
